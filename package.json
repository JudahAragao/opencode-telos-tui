{
  "name": "@telos/opencode-tui",
  "version": "1.1.16",
  "description": "TUI plugin for Telos SDD - provides native TUI commands for /sdd viz, /sdd status, /sdd tasks, and other SDD operations without invoking the LLM",
  "type": "module",
  "exports": {
    "./tui": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^20.10.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "sdd",
    "spec-driven-development",
    "telos",
    "dashboard",
    "knowledge-graph"
  ],
  "author": "Telos Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/telos/opencode-telos.git",
    "directory": "packages/opencode-tui"
  },
  "bugs": {
    "url": "https://github.com/telos/opencode-telos/issues"
  },
  "homepage": "https://github.com/telos/opencode-telos/tree/main/packages/opencode-tui#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}